pragma cashscript ^0.14.0;

// Pay-per-signal escrow.
// A subscriber locks BCH here. The signal provider can take a fixed price
// once per interval, and only by publishing the signal hash on chain.
// The subscriber can take everything back at any time.
contract SignalEscrow(
    bytes20 subscriberPkh,
    bytes20 providerPkh,
    int pricePerSignal,   // satoshis paid per signal
    int minInterval,      // relative timelock in blocks between two charges
    int maxFee            // highest miner fee the provider may take from the escrow
) {
    // Provider charges one signal.
    // Outputs: 0 = price to provider, 1 = remainder back to this contract, 2 = OP_RETURN with the signal hash.
    function charge(pubkey providerPk, sig providerSig, bytes32 signalHash) {
        require(hash160(providerPk) == providerPkh);
        require(checkSig(providerSig, providerPk));

        // At most one charge per interval: the escrow UTXO must be at least minInterval blocks old.
        require(this.age >= minInterval);

        // Output 0 pays exactly the price to the provider.
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(providerPkh));
        require(tx.outputs[0].value == pricePerSignal);

        // Output 1 sends the rest back to this same contract, minus at most maxFee.
        int inputValue = tx.inputs[this.activeInputIndex].value;
        require(tx.outputs[1].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);
        require(tx.outputs[1].value >= inputValue - pricePerSignal - maxFee);

        // Output 2 records the signal on chain.
        require(tx.outputs[2].lockingBytecode == new LockingBytecodeNullData([signalHash]));
        require(tx.outputs[2].value == 0);

        // Nothing else may be paid out.
        require(tx.outputs.length == 3);
    }

    // Subscriber takes everything back, at any time.
    function refund(pubkey subscriberPk, sig subscriberSig) {
        require(hash160(subscriberPk) == subscriberPkh);
        require(checkSig(subscriberSig, subscriberPk));
    }
}
